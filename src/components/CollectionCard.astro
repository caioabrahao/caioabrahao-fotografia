---
import type galleryData from '../data/gallery.json'; //pega o schema do json de galeria

interface Props {
  data: typeof galleryData;
}
const { data } = Astro.props;
const images = Object.values(data.gallery);
---

<div class="bg-earthy-brown-600 text-autumn-bg p-4  w-64 flex flex-col gap-2">
    <div class="grid grid-cols-2 gap-2 bg-earthy-brown-300 p-2">
        {images.slice(0, 4).map((image) => (
            <img src={image.src} alt={image.title} 
            class="aspect-square object-cover drop-shadow-lg" 
            loading="lazy" />
        ))}
    </div>
    <div class="">
        <h4>Fotos Favoritas</h4>
    </div>
    
</div>