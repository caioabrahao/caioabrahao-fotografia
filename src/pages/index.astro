---
import Layout from '../layouts/Layout.astro';
import data from '../data/collections/gallery.json'
const images = Object.values(data.gallery);

import CollectionCard from '../components/CollectionCard.astro';
---

<Layout>
	<div class="mt-4">
		<h1 >Caio R. Abrahão</h1>
	</div>
	<section class="pb-16">
		<div class="flex items-center gap-4">
			<h2>Fotografia</h2>
			<hr class="border text-deep-red-400 w-full">
		</div>
		<p class="mb-4">Algumas das minhas fotos favoritas:</p>
		<div class="gallery grid grid-cols-3 gap-4">
			{images.slice(0, 9).map((image) => (
				<img src={image.src} alt={image.title} 
				class="aspect-square object-cover 
				transition ease-in-out
				hover:scale-110 hover:shadow-2xl" 
				loading="lazy" />
			))}
		</div>
	</section>
	<section class="pb-8">
		<div class="flex items-center gap-4">
			<h2>Coleções</h2>
			<hr class="border text-deep-red-400 w-full">
		</div>
		<p class="mb-4">Coleções de Fotos com algo em comum</p>
		<div class="flex gap-4 overflow-y-hidden p-6 overflow-x-scroll w-full scrollbar snap-x snap-mandatory">
			<CollectionCard data={data}/>
			<CollectionCard data={data}/>
			<CollectionCard data={data}/>
			<CollectionCard data={data}/>
			<CollectionCard data={data}/>
		</div>

	</section>
</Layout>
