---
import Layout from "../../layouts/Layout.astro"

export async function getStaticPaths() {
  const modules = import.meta.glob('../../data/collections/*.json', { eager: true });
  const collections = Object.values(modules) as any[];

  return collections.map((data) => {
    return {
      params: { collection: data.slug }, // Define o nome da URL (ex: /galeria/fotos-favoritas)
      props: { data } // Passa o JSON inteiro como prop para a página
    };
  });
}

interface ImagemGaleria {
  title: string;
  src: string;
  orientation: 'horizontal' | 'vertical';
}

interface Props {
  data: {
    name: string;
    slug: string;
    gallery: {
      [key: string]: ImagemGaleria;
    };
  };
}

const { data } = Astro.props;
const images = Object.values(data.gallery);
---

<Layout>
    <section class="py-8">
        <div class="flex items-center gap-4">
			<h1 class="capitalize mb-4">{data.name}</h1>
			<hr class="border text-deep-red-400 w-full">
		</div>
        <div class="grid grid-cols-3 gap-4">
            {images.map((image) => (
                <div>
                    <img 
                        src={image.src} 
                        alt={image.title} 
                        class="aspect-square object-cover"
                        loading="lazy"
                    />
                    <p class="">{image.title}</p>
                </div>
            ))}
        </div>
    </section>
</Layout>