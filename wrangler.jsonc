{
	"compatibility_date": "2026-06-09",
	"compatibility_flags": [
		"global_fetch_strictly_public",
		"nodejs_compat"
	],
	"name": "caioabrahao-arts",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	 "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "681ba10e44584894a0a15b8a796459ac"
    }
  ]
}